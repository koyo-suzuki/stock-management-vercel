# Required: database connections (Vercel Postgres automatically sets these)
PRISMA_DATABASE_URL="your-prisma-database-url"
DATABASE_URL="your-database-url"

# Required: both administrator credentials must be non-empty
BASIC_AUTH_USER="admin"
BASIC_AUTH_PASSWORD="your-secure-password"

# Optional: guest login is enabled only when both credentials are non-empty
GUEST_AUTH_USER=""
GUEST_AUTH_PASSWORD=""
